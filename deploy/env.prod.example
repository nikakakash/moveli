# Copy to .env.prod next to docker-compose.prod.yml and fill in. NEVER commit the filled file.
#   cp deploy/env.prod.example .env.prod && nano .env.prod

# --- Image tag to deploy (CD sets this to the commit SHA; defaults to latest) ---
IMAGE_TAG=latest

# --- Domains / TLS (Caddy) ---
SITE_DOMAIN=moveli.ge
API_DOMAIN=api.moveli.ge
ACME_EMAIL=you@example.com          # Let's Encrypt registration/expiry notices

# --- Database ---
POSTGRES_DB=moveli
POSTGRES_USER=moveli
POSTGRES_PASSWORD=change-me-strong-db-password

# --- JWT signing key (REQUIRED) ---
# Generate a strong random secret, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-generate-a-48-byte-random-secret
JWT_ISSUER=moveli.ge
JWT_AUDIENCE=moveli.ge

# --- Frontend origin (CORS + links in emails) ---
FRONTEND_ORIGIN=https://moveli.ge

# --- Frontend build-time API URL (baked into the image; must include /api) ---
NEXT_PUBLIC_API_URL=https://api.moveli.ge/api
NEXT_PUBLIC_SITE_URL=https://moveli.ge

# --- First admin (created on first boot only if BOTH are set) ---
SEED_ADMIN_EMAIL=admin@moveli.ge
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# --- SMTP (optional; omit SMTP_HOST to log emails instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@moveli.ge

# --- Uploads storage (Local disk by default; set to S3 for durable/off-box storage) ---
STORAGE_PROVIDER=Local
S3_SERVICE_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Proxy trust. Safe as true because the API is only reachable via Caddy on the internal
#     docker network (not published to the host). ---
TRUST_ALL_PROXIES=true
